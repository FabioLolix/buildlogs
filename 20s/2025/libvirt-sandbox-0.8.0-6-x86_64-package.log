for lang in $linguas; do \
  dir=/build/libvirt-sandbox/pkg/libvirt-sandbox//usr/share/locale/$lang/LC_MESSAGES; \
  /bin/sh /build/libvirt-sandbox/src/libvirt-sandbox-0.8.0/build-aux/install-sh -d $dir; \
  if test -r $lang.gmo; then \
    /usr/bin/install -c -m 644 $lang.gmo $dir/libvirt-sandbox.mo; \
    echo "installing $lang.gmo as $dir/libvirt-sandbox.mo"; \
  else \
    /usr/bin/install -c -m 644 ./$lang.gmo $dir/libvirt-sandbox.mo; \
    echo "installing ./$lang.gmo as" \
	 "$dir/libvirt-sandbox.mo"; \
  fi; \
  if test -r $lang.gmo.m; then \
    /usr/bin/install -c -m 644 $lang.gmo.m $dir/libvirt-sandbox.mo.m; \
    echo "installing $lang.gmo.m as $dir/libvirt-sandbox.mo.m"; \
  else \
    if test -r ./$lang.gmo.m ; then \
      /usr/bin/install -c -m 644 ./$lang.gmo.m \
	$dir/libvirt-sandbox.mo.m; \
      echo "installing ./$lang.gmo.m as" \
	   "$dir/libvirt-sandbox.mo.m"; \
    else \
      true; \
    fi; \
